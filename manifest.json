{
  "manifest_version": 3,
  "name": "Spreadsheet Cell Highlighter",
  "version": "1.0.0",
  "description": "Highlights the active row and column in Google Sheets. Easily customize highlight mode, colors, thickness, and transparency settings.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}