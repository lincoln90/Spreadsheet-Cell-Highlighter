{
  "manifest_version": 3,
  "name": "Enhance Spreadsheet",
  "version": "1.0.0",
  "description": "Google Spreadsheetの操作性を向上させるChrome拡張機能",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ]
}